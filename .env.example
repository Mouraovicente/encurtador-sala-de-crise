# Porta HTTP do servico
PORT=8080

# Base publica usada para montar o shortUrl retornado por POST /links
# Ex.: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Caminho do arquivo do banco SQLite
DB_PATH=./data/links.sqlite

# Endpoint OTLP/HTTP do otel-collector. Se ausente, a aplicacao roda
# normalmente sem exportar telemetria (no-op gracioso, zero crash).
# Ex.: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Nome do servico reportado nos traces/metricas
OTEL_SERVICE_NAME=encurtador-sala-de-crise
